{
  "name": "@nosslabs/iap",
  "version": "8.0.0",
  "description": "Thin Capacitor IAP orchestrator that pairs with Attesto for receipt validation",
  "license": "MIT",
  "author": "nossdev",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "capacitor",
    "capacitor-8",
    "capgo",
    "native-purchases",
    "iap",
    "in-app-purchase",
    "storekit",
    "billing",
    "attesto"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nossdev/iap.git"
  },
  "homepage": "https://github.com/nossdev/iap#readme",
  "bugs": {
    "url": "https://github.com/nossdev/iap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "@capacitor/app": ">=8.0.0",
    "@capacitor/core": ">=8.0.0",
    "@capacitor/preferences": ">=8.0.0",
    "@capgo/native-purchases": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/app": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/native-purchases": "8.6.5",
    "@vitest/coverage-v8": "^1.6.1",
    "jsdom": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.1",
    "vue": "^3.5.33"
  },
  "engines": {
    "node": ">=18"
  }
}
